# Supabase (supabase.com → tu proyecto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# football-data.org (football-data.org → cuenta → API token)
FOOTBALL_DATA_API_TOKEN=

# URL del sitio (local: http://localhost:3000 | prod: https://prode-sabor-argento.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Contraseña del dashboard /admin (elegir cualquier string)
ADMIN_PASSWORD=

# Secret para el cron de sync-matches (elegir cualquier string)
CRON_SECRET=
